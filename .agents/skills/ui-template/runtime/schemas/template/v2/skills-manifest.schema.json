{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/template/v2/skills-manifest.schema.json",
  "title": "Dual-skill bundle manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "bundle_version", "skills", "template_schema", "files", "generator", "licenses"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "bundle_version": {"$ref": "common.schema.json#/$defs/semver"},
    "skills": {
      "type": "object", "additionalProperties": false, "required": ["ui-template", "ui-template-apply"],
      "properties": {"ui-template": {"$ref": "common.schema.json#/$defs/semver"}, "ui-template-apply": {"$ref": "common.schema.json#/$defs/semver"}}
    },
    "template_schema": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"const": 2}, "maximum": {"const": 2}}},
    "files": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "generator": {"type": "object", "additionalProperties": false, "required": ["name", "version", "revision"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"$ref": "common.schema.json#/$defs/semver"}, "revision": {"type": "string", "minLength": 1}, "revision_time": {"type": "integer", "minimum": 0}}},
    "archive": {"type": "object", "additionalProperties": false, "required": ["format", "ordering", "mtime", "uid", "gid", "checksum"], "properties": {"format": {"const": "tar.gz"}, "ordering": {"const": "path-lexicographic"}, "mtime": {"type": "integer", "minimum": 0}, "uid": {"const": 0}, "gid": {"const": 0}, "checksum": {"const": "sha256-sidecar"}}},
    "licenses": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["subject", "license"], "properties": {"subject": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1}, "version": {"$ref": "common.schema.json#/$defs/semver"}, "path": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "managedPath": {
      "type": "string",
      "pattern": "^(?:LICENSE|VERSION|CHANGELOG\\.md|compatibility\\.yaml|MIGRATION-v1-to-v2\\.md|ROLLBACK\\.md|skills/(?:ui-template|ui-template-apply)/[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*)$"
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "license"],
      "properties": {
        "path": {"$ref": "#/$defs/managedPath"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "license": {"type": "string", "minLength": 1}
      }
    }
  }
}
