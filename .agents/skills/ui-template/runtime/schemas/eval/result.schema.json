{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/eval/result.schema.json",
  "title": "Contract eval run result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runner_version", "revision", "runtime_fingerprint", "counts", "fixture_hashes", "baseline", "results", "status", "failures", "discovery"],
  "properties": {
    "schema_version": {"const": 1},
    "runner_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "revision": {"type": "string", "minLength": 1},
    "runtime_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "parsed", "executed", "script", "llm"],
      "properties": {
        "declared": {"type": "integer", "minimum": 0},
        "parsed": {"type": "integer", "minimum": 0},
        "executed": {"type": "integer", "minimum": 0},
        "script": {"type": "integer", "minimum": 0},
        "llm": {"type": "integer", "minimum": 0}
      }
    },
    "fixture_hashes": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "diff"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"enum": ["matched", "different", "not-checked"]},
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "removed", "changed"],
          "properties": {
            "added": {"type": "array", "items": {"type": "string"}},
            "removed": {"type": "array", "items": {"type": "string"}},
            "changed": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/caseResult"}
    },
    "status": {"enum": ["passed", "failed"]},
    "failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_excluded", "exclusions", "inputs"],
      "properties": {
        "example_excluded": {"type": "boolean"},
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "category", "judge", "fixture", "fixture_sha256", "revision", "runtime_fingerprint", "execution", "status", "blocking", "details"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "skill": {"enum": ["ui-template", "ui-template-apply"]},
        "category": {"type": "string", "minLength": 1},
        "judge": {"enum": ["script", "llm"]},
        "fixture": {"type": "string", "minLength": 1},
        "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": "string", "minLength": 1},
        "runtime_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "execution": {"enum": ["script", "llm-asset-validation", "llm-result-adapter"]},
        "status": {"enum": ["passed", "failed", "asset-valid"]},
        "blocking": {"type": "boolean"},
        "details": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
