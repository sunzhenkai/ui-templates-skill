{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/design-system/v1/apply-checkpoint.schema.json",
  "title": "Design System Apply checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "template", "tokens_digest", "scope", "source_identity", "build_identity", "phases", "updated_at"],
  "properties": {
    "schema": {"const": "design-system-apply-checkpoint/v1"},
    "mode": {"enum": ["bootstrap", "increment"]},
    "change_set": {"type": "array", "items": {"type": "string"}},
    "contract": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": {"id": {"$ref": "common.schema.json#/$defs/slug"}, "version": {"$ref": "common.schema.json#/$defs/semver"}, "digest": {"$ref": "common.schema.json#/$defs/digest"}}
    },
    "template": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "common.schema.json#/$defs/semver"},
        "origin": {"enum": ["catalog", "project", "active"]},
        "resolved_path": {"type": "string", "minLength": 1},
        "fidelity": {"enum": ["repo-structural-v1", "legacy-baseline", "style-only", "unknown"]},
        "digest": {
          "description": "sha256-canonical-json-v1 over {template: meta.yaml, fidelity: fidelity.yaml, primitives: core/primitives.yaml}; the checkpoint binds template identity here, never as a bare string.",
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "tokens_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "scope": {
      "description": "Apply scope decision; a scope change is a Phase 0 identity change, not a phase-local one.",
      "type": "object", "additionalProperties": false,
      "required": ["included", "deferred", "excluded"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string"}},
        "deferred": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}}
      }
    },
    "fidelity": {
      "description": "Oracle-anchored expectation comparison state. Apply consumes the measured expectation set source-blind and records only its digest, expectation ids and comparison outcomes; oracle revision or locator must never appear here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["verified", "fidelity-unverified", "not-applicable"]},
        "expectation_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "expectation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^expectation-[0-9a-zA-Z-]{3,80}$"}
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expectation_id", "result"],
            "properties": {
              "expectation_id": {"type": "string", "pattern": "^expectation-[0-9a-zA-Z-]{3,80}$"},
              "result": {"enum": ["passed", "failed"]},
              "expected": {},
              "actual": {},
              "tolerance": {"type": "string"}
            }
          }
        }
      }
    },
    "source_identity": {"type": "string", "minLength": 1},
    "binding_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "projection_digests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": {"name": {"type": "string"}, "digest": {"$ref": "common.schema.json#/$defs/digest"}}}},
    "stable_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/entityId"}},
    "output_root": {"type": "string", "minLength": 1},
    "build_identity": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "phases": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"type": "integer", "minimum": 0, "maximum": 9}, "status": {"enum": ["pending", "in-progress", "complete", "stale", "blocked"]}, "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"$ref": "common.schema.json#/$defs/path"}, "digest": {"$ref": "common.schema.json#/$defs/digest"}}}}}}}
  }
}
