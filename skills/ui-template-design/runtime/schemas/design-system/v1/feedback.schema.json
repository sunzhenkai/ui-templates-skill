{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/design-system/v1/feedback.schema.json",
  "title": "Design System package feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "fingerprint", "package", "ownership", "scenario", "suggestion", "status", "evidence_refs", "created_at", "updated_at", "status_history"],
  "properties": {
    "schema": {"const": "design-system-feedback/v1"},
    "id": {"$ref": "common.schema.json#/$defs/uuid"},
    "fingerprint": {"$ref": "common.schema.json#/$defs/fingerprint"},
    "package": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "capability", "digest"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/slug"},
        "version": {"$ref": "common.schema.json#/$defs/semver"},
        "capability": {"enum": ["tokens-only", "ui-kit", "page-system"]},
        "digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "ownership": {"const": "package"},
    "scenario": {"type": "string", "minLength": 1},
    "suggestion": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "accepted", "known-gap", "rejected", "applied", "verified"]},
    "reason": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/entityId"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status_history": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "at"], "properties": {"from": {"type": ["null", "string"]}, "to": {"type": "string"}, "at": {"$ref": "common.schema.json#/$defs/timestamp"}, "reason": {"type": "string"}}}}
  }
}
