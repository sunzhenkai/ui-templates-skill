{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/template/v2/feedback.schema.json",
  "title": "Template feedback v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "fingerprint", "template", "scenario", "suggestion", "scope", "status", "evidence_refs", "created_at", "updated_at", "status_history"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/uuid"},
    "fingerprint": {"$ref": "common.schema.json#/$defs/fingerprint"},
    "template": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "source_revision"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"$ref": "common.schema.json#/$defs/semver"}, "source_revision": {"type": "string", "minLength": 1}}
    },
    "scenario": {"type": "string", "minLength": 1},
    "suggestion": {"type": "string", "minLength": 1},
    "scope": {"enum": ["template-rule", "template-quality", "project-only"]},
    "status": {"$ref": "#/$defs/status"},
    "reason": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/ruleId"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transition"}}
  },
  "$defs": {
    "status": {"enum": ["proposed", "accepted", "known-gap", "rejected", "applied", "verified"]},
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "at"],
      "properties": {
        "from": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/status"}]},
        "to": {"$ref": "#/$defs/status"},
        "at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"from": {"not": {"type": "null"}}}, "required": ["from"]},
          "then": {"required": ["reason"]}
        }
      ]
    }
  }
}
