{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/template/v2/common.schema.json",
  "title": "UI template v2 shared definitions",
  "$defs": {
    "schemaVersion": {"const": 2},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "origin": {"enum": ["source", "computed", "estimated", "default"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "sourceType": {"enum": ["web", "repo", "image", "doc"]},
    "tokenPath": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+$"},
    "ruleId": {"type": "string", "pattern": "^(NN|TOKEN|LAYOUT|ROUTE|AX|RESP|QUALITY)-[0-9]{3}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "date": {"type": "string", "format": "date"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json-v1"},
        "value": {"$ref": "#/$defs/sha256"}
      }
    },
    "findingCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "findingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path"],
      "properties": {
        "code": {"$ref": "#/$defs/findingCode"},
        "path": {"type": "string", "minLength": 1},
        "rule_id": {"$ref": "#/$defs/ruleId"}
      }
    },
    "uuid": {"type": "string", "format": "uuid"},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1}
  }
}
