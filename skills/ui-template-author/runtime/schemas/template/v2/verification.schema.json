{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/template/v2/verification.schema.json",
  "title": "Template Apply verification/review v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "template_digest", "source_identity", "build_identity", "browser_identity", "records", "created_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "kind": {"enum": ["phase-8-verification", "phase-9-review"]},
    "template_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "source_identity": {"type": "string", "minLength": 1},
    "build_identity": {"type": "string", "minLength": 1},
    "browser_identity": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "verification_contract": {"enum": ["numeric-v1"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "phase-8-verification"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "records": {"items": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"status": {"enum": ["passed", "failed", "waived"]}}, "required": ["scenario_ids"], "not": {"required": ["phase8_record_id"]}}]}}
        },
        "if": {"properties": {"verification_contract": {"const": "numeric-v1"}}, "required": ["verification_contract"]},
        "then": {
          "properties": {
            "records": {"items": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"status": {"enum": ["passed", "failed", "waived"]}}, "required": ["measurements"]}]}}
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "phase-9-review"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "records": {"items": {"allOf": [{"$ref": "#/$defs/record"}, {"required": ["phase8_record_id"], "properties": {"status": {"enum": ["recheck-passed", "recheck-failed"]}}, "not": {"required": ["scenario_ids"]}}]}}
        }
      }
    }
  ],
  "$defs": {
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "method", "expected", "observed", "passed", "evidence_ref"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "method": {"enum": ["computed-style", "logical-geometry", "scroll-metrics", "interaction-probe", "accessibility-tree"]},
        "expected": {},
        "observed": {"type": ["string", "number"], "minLength": 1},
        "passed": {"type": "boolean"},
        "tolerance": {"type": "string", "pattern": "^(?:<=|≤)\\s*[0-9]+(?:\\.[0-9]+)?px$"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule_id", "status", "expected", "actual", "route", "viewport", "theme", "state", "evidence_refs"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "phase8_record_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "rule_id": {"$ref": "common.schema.json#/$defs/ruleId"},
        "status": {"enum": ["passed", "failed", "waived", "recheck-passed", "recheck-failed"]},
        "expected": {}, "actual": {},
        "route": {"type": "string", "minLength": 1},
        "viewport": {"type": "string", "minLength": 1},
        "theme": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "scenario_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "measurements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurement"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
