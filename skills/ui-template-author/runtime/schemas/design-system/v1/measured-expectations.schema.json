{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/design-system/v1/measured-expectations.schema.json",
  "title": "Design System measured expectations v1",
  "description": "Oracle-anchored expectations produced by the Template Certification Gate and consumed source-blind by Apply. Measurements only: no oracle source paths, DOM fragments or CSS class names are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package",
    "oracle",
    "prompts_digest",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "design-system-measured-expectations/v1"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git-revision"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{8,64}$"
        },
        "locator": {
          "type": "string"
        }
      }
    },
    "prompts_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256-canonical-json-v1",
            "sha256-file-v1",
            "sha256-tree-v1"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pattern",
          "dimension",
          "method",
          "expected",
          "unit",
          "oracle_revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^expectation-[0-9a-zA-Z-]{3,80}$"
          },
          "pattern": {
            "$ref": "common.schema.json#/$defs/entityId"
          },
          "dimension": {
            "enum": [
              "structure",
              "hierarchy",
              "spacing",
              "density",
              "typography",
              "color",
              "surface",
              "border",
              "divider"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "expected": {},
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "tolerance": {
            "type": "string"
          },
          "oracle_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{8,64}$"
          },
          "oracle_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
