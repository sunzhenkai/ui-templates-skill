{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/design-system/v1/tokens.schema.json",
  "title": "Design System tokens v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tokens"
  ],
  "properties": {
    "schema": {
      "const": "design-system-tokens/v1"
    },
    "tokens": {
      "$ref": "#/$defs/group"
    },
    "color_pairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/colorPair"
      }
    }
  },
  "$defs": {
    "tokenRecord": {
      "type": [
        "object"
      ],
      "additionalProperties": false,
      "required": [
        "value",
        "origin"
      ],
      "properties": {
        "value": {},
        "origin": {
          "$ref": "common.schema.json#/$defs/origin"
        },
        "unit": {
          "enum": [
            "px",
            "rem",
            "em",
            "%",
            "ms",
            "s",
            "deg",
            "ratio",
            "unitless"
          ]
        },
        "line_height": {
          "type": "number"
        },
        "line_height_unit": {
          "enum": [
            "px",
            "rem",
            "em",
            "%",
            "unitless"
          ]
        },
        "font_weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "description": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "array",
                "contains": {
                  "type": "number"
                }
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        }
      ]
    },
    "colorPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foreground",
        "background",
        "min_ratio"
      ],
      "properties": {
        "foreground": {
          "type": "string",
          "pattern": "^token/[A-Za-z0-9_.-]+$"
        },
        "background": {
          "type": "string",
          "pattern": "^token/[A-Za-z0-9_.-]+$"
        },
        "min_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 21
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "group": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/tokenRecord"
          },
          {
            "$ref": "#/$defs/group"
          }
        ]
      }
    }
  }
}
