{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/design-system/v1/primitives.schema.json",
  "title": "Design System primitives v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "design-system-primitives/v1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "states"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/entityId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "token_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/entityId"
            }
          },
          "anatomy": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot",
                "order"
              ],
              "properties": {
                "slot": {
                  "enum": [
                    "icon",
                    "label",
                    "badge",
                    "shortcut",
                    "trailing",
                    "avatar",
                    "count",
                    "status",
                    "chevron",
                    "checkbox",
                    "description",
                    "media",
                    "action",
                    "indicator",
                    "progress",
                    "activity"
                  ]
                },
                "order": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "required": {
                  "type": "boolean",
                  "description": "Slot must render whenever the primitive renders (default true). Optional slots may be absent for some instances."
                },
                "content": {
                  "enum": [
                    "icon",
                    "text",
                    "image",
                    "number",
                    "kbd",
                    "indicator",
                    "control"
                  ],
                  "description": "What the slot carries; icon/image slots must render a graphic (svg/img/role=img)."
                },
                "size_ref": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+$"
                }
              }
            },
            "description": "Ordered content slots. Implementations mark the primitive root with data-primitive=<slug> and each slot with data-slot=<slot> so anatomy conformance is machine-checkable."
          },
          "variant_contracts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "presentation",
                "radius"
              ],
              "properties": {
                "presentation": {
                  "enum": [
                    "filled",
                    "outline",
                    "ghost",
                    "plain"
                  ]
                },
                "radius": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+$"
                },
                "control_height": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+$"
                },
                "hover": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+(@[0-9]{1,3}%)?$"
                },
                "active": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+$"
                },
                "focus_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "background": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+(@[0-9]{1,3}%)?$",
                  "description": "color token ref, optional @<alpha>% mix"
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+(@[0-9]{1,3}%)?$",
                  "description": "color token ref, optional @<alpha>% mix"
                },
                "border": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+(@[0-9]{1,3}%)?$",
                  "description": "color token ref, optional @<alpha>% mix"
                },
                "theme_overrides": {
                  "type": "object",
                  "description": "per theme variant resting colors when the source changes more than the token value (e.g. a different alpha)",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "background": {
                        "type": "string",
                        "pattern": "^token/[A-Za-z0-9_.-]+(@[0-9]{1,3}%)?$",
                        "description": "color token ref, optional @<alpha>% mix"
                      },
                      "foreground": {
                        "type": "string",
                        "pattern": "^token/[A-Za-z0-9_.-]+(@[0-9]{1,3}%)?$",
                        "description": "color token ref, optional @<alpha>% mix"
                      },
                      "border": {
                        "type": "string",
                        "pattern": "^token/[A-Za-z0-9_.-]+(@[0-9]{1,3}%)?$",
                        "description": "color token ref, optional @<alpha>% mix"
                      },
                      "hover": {
                        "type": "string",
                        "pattern": "^token/[A-Za-z0-9_.-]+(@[0-9]{1,3}%)?$",
                        "description": "color token ref, optional @<alpha>% mix"
                      }
                    }
                  }
                }
              }
            }
          },
          "context_bindings": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selected"
              ],
              "properties": {
                "selected": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+$"
                },
                "hover": {
                  "type": "string",
                  "pattern": "^token/[A-Za-z0-9_.-]+$"
                }
              }
            }
          },
          "anatomy_exempt": {
            "type": "string",
            "minLength": 1,
            "description": "Reason a primitive has no content slots (pure container/layout). ui-kit/page-system primitives must declare anatomy or this reason."
          },
          "interaction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "description": "Overlay / disclosure behaviour. Required for primitives whose kind is overlay or disclosure (validate_interaction_primitives).",
            "properties": {
              "kind": {
                "enum": [
                  "overlay",
                  "disclosure",
                  "control"
                ]
              },
              "trigger": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "hover",
                    "focus",
                    "click",
                    "contextmenu",
                    "long-press",
                    "keyboard"
                  ]
                }
              },
              "dismiss": {
                "type": "array",
                "items": {
                  "enum": [
                    "escape",
                    "outside-click",
                    "blur",
                    "select",
                    "pointer-leave"
                  ]
                }
              },
              "placement": {
                "type": "string"
              },
              "persist_ref": {
                "type": "string",
                "description": "Where disclosure state persists (e.g. storage key role), if any."
              },
              "covers": {
                "type": "array",
                "items": {
                  "enum": [
                    "accordion",
                    "collapsible",
                    "command",
                    "context-menu",
                    "dialog",
                    "drawer",
                    "dropdown-menu",
                    "hover-card",
                    "popover",
                    "rail-collapse",
                    "tabs",
                    "toast",
                    "tooltip"
                  ]
                },
                "description": "Captured interaction_inventory kinds this primitive realises; the authoring gate requires every captured overlay/disclosure kind to be covered."
              }
            }
          }
        }
      }
    }
  }
}
