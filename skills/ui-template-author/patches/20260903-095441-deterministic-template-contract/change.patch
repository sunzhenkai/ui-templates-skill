+    foreground: { value: "#e5e7eb", origin: default }
+typography:
+  family:
+    body: { value: "Inter, system-ui, sans-serif", origin: default }
+  scale:
+    body: { size: 14, lineHeight: 20, origin: source }
+spacing:
+  base: 4
+  allowed: [4, 8, 12, 16, 24, 32]
+radius:
+  control: 10
+  card: 8
+```
 
