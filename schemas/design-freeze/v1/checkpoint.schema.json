{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/design-freeze/v1/checkpoint.schema.json",
  "title": "Design skill checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "output_root", "phases", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["greenfield", "existing"]},
    "output_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)(?:\\.|[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*)$"
    },
    "freeze_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json-v1"},
        "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_identity": {"type": "string", "minLength": 1},
    "build_identity": {"type": "string", "minLength": 1},
    "task_class": {"enum": ["bootstrap", "refactor", "iterate"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "phases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 0}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 1}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 2}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 3}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 4}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 5}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 6}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 7}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 8}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"id": {"const": 9}}}]}
      ],
      "items": false
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "artifacts"],
      "properties": {
        "id": {"type": "integer", "minimum": 0, "maximum": 9},
        "status": {"enum": ["pending", "in-progress", "complete", "stale", "blocked"]},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {
                "type": "object",
                "additionalProperties": false,
                "required": ["algorithm", "value"],
                "properties": {
                  "algorithm": {"const": "sha256-canonical-json-v1"},
                  "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                }
              }
            }
          }
        }
      }
    }
  }
}
