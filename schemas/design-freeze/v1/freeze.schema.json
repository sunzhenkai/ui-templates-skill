{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/design-freeze/v1/freeze.schema.json",
  "title": "Design freeze v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "digest", "mode", "kit", "updated_at"],
  "properties": {
    "schema": {"const": "design-freeze/v1"},
    "status": {"enum": ["pending", "frozen"]},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json-v1"},
        "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "mode": {"enum": ["greenfield", "existing"]},
    "template": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "digest"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "digest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "value"],
              "properties": {
                "algorithm": {"const": "sha256-canonical-json-v1"},
                "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      ]
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitives", "patterns", "gallery"],
      "properties": {
        "primitives": {"type": "boolean"},
        "patterns": {"type": "boolean"},
        "gallery": {"type": "boolean"}
      }
    },
    "golden_page": {"type": ["string", "null"]},
    "output_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)(?:\\.|[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*)$"
    },
    "touched_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "rules_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
