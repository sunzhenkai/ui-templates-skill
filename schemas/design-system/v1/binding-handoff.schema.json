{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-templates-skill.local/schemas/design-system/v1/binding-handoff.schema.json",
  "title": "Design System binding handoff v1",
  "description": "Apply Phase 9 发现的 binding 归属缺口交给 ui-template-design 的交接产物。binding 缺陷属于项目 binding/projection，不得写进 package feedback（见 feedback.schema.json 的 ownership 闭集），此前没有交接产物，导致该归属类别无主。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "created_at", "active_instance", "findings"],
  "properties": {
    "schema": {"const": "design-system-binding-handoff/v1"},
    "id": {"$ref": "common.schema.json#/$defs/uuid"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "active_instance": {
      "description": "交接所依据的 Active Instance 身份；binding digest 变化使既有结论过期。",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_version", "binding_digest"],
      "properties": {
        "contract_id": {"$ref": "common.schema.json#/$defs/slug"},
        "contract_version": {"$ref": "common.schema.json#/$defs/semver"},
        "binding_digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "statement", "evidence_refs"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/entityId"},
          "layer": {"enum": ["binding", "projection", "primitive-paths"]},
          "statement": {"type": "string", "minLength": 1},
          "expected": {},
          "actual": {},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
